<section class="hero">
  <div class="hero-container">
    <div class="hero-badge">
      <span class="pulse-dot"></span>
      <span>Local-First · Privacy-Focused · Under Active Development</span>
    </div>

    <h1 class="hero-title">Nadirix Flow</h1>
    <p class="hero-subtitle">Intelligence in Motion</p>

    <p class="hero-description">
      A local-first household AI and operations platform combining intelligent assistance,
      infrastructure awareness, diagnostics, research, and future Maintenance AI capabilities.
    </p>

    <div class="hero-cta">
      <a href="https://docs.nadirix-flow.cc" class="btn btn-primary" target="_blank" rel="noopener">
        Get Started
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="https://github.com/Krazy-Killa/Nadirix-Flow" class="btn btn-secondary" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        View on GitHub
      </a>
    </div>

    <div class="hero-pills">
      <div class="pill">Local AI Inference</div>
      <div class="pill">Privacy-Conscious</div>
      <div class="pill">HomeLab & Operations</div>
      <div class="pill">Evidence-Driven</div>
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 24px 80px;
    overflow: hidden;
  }

  .hero-container {
    max-width: 760px;
    position: relative;
    z-index: 2;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border-radius: 100px;
    background: var(--accent-dim);
    border: 1px solid var(--border-hover);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.05em;
    margin-bottom: 32px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: 4.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    background: linear-gradient(180deg, var(--text) 0%, var(--text-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 28px;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 580px;
    margin: 0 auto 40px;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .hero-pills {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .pill {
    padding: 6px 16px;
    border-radius: 100px;
    background: var(--panel);
    border: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }


  @media (max-width: 768px) {
    .hero-title {
      font-size: 3rem;
    }
    .hero-subtitle {
      font-size: 1.25rem;
    }
    .hero-description {
      font-size: 1rem;
    }
  }
</style>
