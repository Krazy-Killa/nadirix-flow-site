---
const steps = [
  { num: '01', title: 'Clone the repository', desc: 'Get the latest source from GitHub.' },
  { num: '02', title: 'Configure local settings', desc: 'Set up your environment and preferences.' },
  { num: '03', title: 'Start the backend', desc: 'Launch the FastAPI backend service.' },
  { num: '04', title: 'Open the dashboard', desc: 'Access the browser-based dashboard UI.' },
  { num: '05', title: 'Connect optional services', desc: 'Link Discord, Proxmox, and other integrations.' },
];
---

<section id="quickstart" class="quickstart">
  <div class="container">
    <div class="section-label">Getting Started</div>
    <h2 class="section-title">Quick Start</h2>
    <p class="section-subtitle">
      A short overview to get you oriented. For full installation instructions, configuration
      details, and deployment guides, head to the documentation portal.
    </p>

    <div class="quickstart-layout">
      <div class="steps">
        {steps.map((step) => (
          <div class="step glass">
            <div class="step-num">{step.num}</div>
            <div class="step-content">
              <h3 class="step-title">{step.title}</h3>
              <p class="step-desc">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="quickstart-cta">
        <div class="quickstart-panel glass">
          <div class="panel-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="panel-title">nadirix-flow</span>
          </div>
          <div class="terminal">
            <div class="term-line"><span class="prompt">$</span> git clone https://github.com/Krazy-Killa/Nadirix-Flow</div>
            <div class="term-line"><span class="prompt">$</span> cd Nadirix-Flow</div>
            <div class="term-line"><span class="prompt">$</span> <span class="comment"># Configure your local settings</span></div>
            <div class="term-line"><span class="prompt">$</span> python -m venv .venv && source .venv/bin/activate</div>
            <div class="term-line"><span class="prompt">$</span> pip install -r requirements.txt</div>
            <div class="term-line"><span class="prompt">$</span> uvicorn main:app --reload</div>
            <div class="term-line success"><span class="prompt">✓</span> Dashboard running at http://localhost:8000</div>
          </div>
          <a href="https://docs.nadirix-flow.cc" class="btn btn-primary full" target="_blank" rel="noopener">
            Read Setup Guide
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .quickstart-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .step {
    display: flex;
    gap: 18px;
    padding: 20px 24px;
    align-items: center;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--accent);
    opacity: 0.6;
    min-width: 36px;
  }

  .step-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 2px;
  }

  .step-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .quickstart-panel {
    padding: 0;
    overflow: hidden;
  }

  .panel-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: var(--raised);
    border-bottom: 1px solid var(--border);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot.red { background: #ff5f57; }
  .dot.yellow { background: #febc2e; }
  .dot.green { background: #28c840; }

  .panel-title {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .terminal {
    padding: 20px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.8;
  }

  .term-line {
    color: var(--text-secondary);
  }

  .prompt {
    color: var(--accent);
    margin-right: 8px;
  }

  .comment {
    color: var(--text-secondary);
    opacity: 0.5;
  }

  .term-line.success {
    color: var(--accent);
    margin-top: 8px;
  }

  .btn.full {
    width: calc(100% - 40px);
    justify-content: center;
    margin: 0 20px 20px;
  }

  @media (max-width: 768px) {
    .quickstart-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
